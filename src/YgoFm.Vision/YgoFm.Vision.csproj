<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Brings in System.Drawing (Bitmap, Graphics.CopyFromScreen) and Screen.AllScreens
         from the Windows Desktop framework, with no NuGet package needed. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
