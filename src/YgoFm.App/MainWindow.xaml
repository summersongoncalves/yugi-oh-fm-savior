<Window x:Class="YgoFm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yu-Gi-Oh! Forbidden Memories — Assistente" Height="820" Width="820"
        MinHeight="560" MinWidth="680">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Avançado">
                <MenuItem Header="Listar cartas aprendidas" Click="ListLearnedCards_Click" />
                <Separator />
                <MenuItem Header="Limpar aprendizado" Click="ClearLearning_Click" />
            </MenuItem>
        </Menu>

        <!--
             Media-player-style controls: only one of these three is ever visible at a time
             except Pause/Resume and Stop, which show together while observing. Visibility is
             toggled entirely in code (see MainWindow.xaml.cs's UpdateControlButtons) rather than
             through triggers/converters, since it is one simple three-state machine (Idle /
             Running / Paused) and a converter would be more indirection for the same result.
        -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,6">
            <Button x:Name="StartButton" Padding="16,10" Click="Start_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Iniciar" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>
            <Button x:Name="PauseButton" Padding="16,10" Margin="8,0,0,0" Click="PauseResume_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PauseIcon" Text="⏸" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock x:Name="PauseLabel" Text="Pausar" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Padding="16,10" Margin="8,0,0,0" Click="Stop_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏹" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Parar" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" Style="{StaticResource Hint}"
                   Text="Clique em Iniciar para escolher a janela do emulador e a região da mão." />

        <TextBlock x:Name="LearningStatusText" DockPanel.Dock="Bottom" Margin="8,4,8,0" Style="{StaticResource Hint}"
                   Text="Biblioteca ensinada: 0 cartas." />

        <!--
             Single column, stacked top to bottom: the preview snapshot (sized to its own actual
             pixels, not stretched to fill space — see PreviewImage below), then the hand-reading
             table (sized to exactly its 5 rows, no wasted space), then the fusion list filling
             whatever is left. Each "Auto" row asks WPF to size that row to its content's natural
             height rather than sharing space proportionally, which is what makes both the image
             and the 5-row table hug their real content instead of stretching.
        -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#999" BorderThickness="1" Background="#111"
                    HorizontalAlignment="Center">
                <!-- Stretch="None" shows the captured hand crop at its real pixel size instead of
                     scaling it to fill whatever space is available — that scaling is exactly what
                     made the old side-by-side layout size this area arbitrarily. -->
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>

            <!-- No explicit Height: a ListView with nothing constraining it sizes to fit its
                 items' natural height, and this always holds exactly 5 rows (one per hand slot),
                 so "natural height" already means "just tall enough for 5 rows plus the header". -->
            <ListView Grid.Row="2" x:Name="ReadingsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Slot" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Slot}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Carta" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardLabel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Confiança" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VerdictLabel}" Foreground="{Binding VerdictBrush}" FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Pontuação" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScoreLabel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Fonte" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceLabel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="4" Text="Fusões de monstro possíveis" FontWeight="Bold" Margin="2,8,2,4" />

            <Grid Grid.Row="5">
                <!--
                     No GridView/headers here on purpose — each row is a whole ready-made
                     WPF element (built by FusionRowBuilder) reading like "carta + carta = carta",
                     not a spreadsheet. An ItemsControl accepts already-built UIElements directly
                     as its items with no DataTemplate needed, which is what FusionRowBuilder
                     hands it; see that class for why the rows are built in code instead of XAML.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FusionsList" />
                </ScrollViewer>

                <TextBlock x:Name="NoFusionsText" Style="{StaticResource Hint}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                           Text="Nenhuma fusão possível com as cartas reconhecidas agora." Visibility="Collapsed" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
