<Window x:Class="YgoFm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yu-Gi-Oh! Forbidden Memories — Assistente" Height="560" Width="820"
        MinHeight="360" MinWidth="560">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="StartMenuItem" Header="_Start" Click="Start_Click" />
        </Menu>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" Style="{StaticResource Hint}"
                   Text="Clique em Start no menu para escolher a janela do emulador e a região da mão." />

        <TextBlock x:Name="LearningStatusText" DockPanel.Dock="Bottom" Margin="8,4,8,0" Style="{StaticResource Hint}"
                   Text="Biblioteca ensinada: 0 cartas." />

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#999" BorderThickness="1" Background="#111">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" x:Name="ReadingsList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Slot" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Slot}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Carta" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CardLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Confiança" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VerdictLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Pontuação" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ScoreLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fonte" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="2" Text="Fusões de monstro possíveis" FontWeight="Bold" Margin="2,0,2,4" />

                <ListView Grid.Row="3" x:Name="FusionsList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Carta A" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CardA}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Carta B" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CardB}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Resultado" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Result}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
