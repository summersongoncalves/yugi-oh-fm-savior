<Window x:Class="YgoFm.App.SelectEmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolha a janela do emulador" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="15" FontWeight="Bold"
                   Text="Selecione a janela do emulador" />

        <!-- Padding (not just Width) is what actually grows a WPF Button's height — Height
             alone would clip the content instead of giving it room, since a Button sizes to
             its content by default unless something inside pushes that content larger. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Padding="14,10" Margin="0,0,8,0" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="15" Margin="0,0,6,0" />
                    <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Padding="14,10" Margin="0,0,8,0" IsDefault="True" Click="Select_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" FontSize="15" Margin="0,0,6,0" />
                    <TextBlock Text="Selecionar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Padding="14,10" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" FontSize="15" Margin="0,0,6,0" />
                    <TextBlock Text="Cancelar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ListBox x:Name="WindowList" DisplayMemberPath="Display" />
    </DockPanel>
</Window>
