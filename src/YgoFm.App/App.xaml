<!-- No StartupUri: MainWindow is no longer shown automatically on launch. App.OnStartup shows
     SplashWindow first and only creates MainWindow once the splash's fade sequence finishes —
     see that override for why. -->
<Application x:Class="YgoFm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
        </Style>

    </Application.Resources>
</Application>
