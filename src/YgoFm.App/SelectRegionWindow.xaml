<Window x:Class="YgoFm.App.SelectRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecione uma região" Height="640" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinHeight="360" MinWidth="480">
    <DockPanel Margin="12">
        <TextBlock x:Name="InstructionsText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Margin="0,0,12,0" Text="Arraste sobre a imagem para marcar a região." />
            <Button Content="Confirmar" Width="100" Margin="0,0,6,0" IsDefault="True" Click="Confirm_Click" />
            <Button Content="Cancelar" Width="100" IsCancel="True" />
        </StackPanel>

        <Border BorderBrush="#999" BorderThickness="1">
            <Grid x:Name="Stage" ClipToBounds="True">
                <Image x:Name="Snapshot" Stretch="Uniform" />
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseUp="Overlay_MouseUp" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
