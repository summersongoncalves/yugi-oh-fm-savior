<Window x:Class="YgoFm.App.SelectRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecione as regiões" Height="640" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinHeight="360" MinWidth="480">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Selecione a área das 5 cartas e também onde ficam o nome e pontuação, conforme a imagem" />
            <Button Content="ℹ" FontSize="14" Width="26" Height="26" Margin="8,0,0,0"
                    ToolTip="Ver exemplo de como marcar" Click="ShowGuide_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <Button Content="Confirmar" Width="100" Margin="0,0,6,0" IsDefault="True" Click="Confirm_Click" />
            <Button Content="Cancelar" Width="100" IsCancel="True" />
        </StackPanel>

        <Border BorderBrush="#999" BorderThickness="1">
            <Grid x:Name="StageGrid" ClipToBounds="True">
                <Image x:Name="Snapshot" Stretch="Uniform" />
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseUp="Overlay_MouseUp" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
