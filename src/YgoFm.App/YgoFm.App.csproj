<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Matches YgoFm.Vision's TFM, which needs the Windows-version-qualified form to reach
         Windows.Media.Ocr (see that project for why). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF only. Windows Forms is deliberately not enabled here: it would import global
         usings whose Application, MouseEventArgs and KeyEventArgs collide with WPF's own.
         YgoFm.Vision uses Windows Forms internally for Screen.AllScreens and Graphics.Copy-
         FromScreen; both flags resolve to the same Microsoft.WindowsDesktop.App framework
         reference, so System.Drawing stays available here through the project reference. -->
    <UseWPF>true</UseWPF>
    <!-- Per-monitor DPI awareness, so the screen pixel coordinates the user drags out for
         the card region are not silently rescaled on displays above 100% scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YgoFm.Core\YgoFm.Core.csproj" />
    <ProjectReference Include="..\YgoFm.Vision\YgoFm.Vision.csproj" />
  </ItemGroup>

</Project>
