<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF only. Windows Forms is deliberately not enabled here: it would import
         global usings that collide with WPF's own Application, MouseEventArgs and
         KeyEventArgs types. The Vision library uses Windows Forms internally, and both
         flags resolve to the same Microsoft.WindowsDesktop.App framework reference,
         so System.Drawing is still available. -->
    <UseWPF>true</UseWPF>
    <!-- Per-monitor DPI awareness, so screen pixel coordinates are not silently
         rescaled on displays running at anything other than 100% scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YgoFm.Vision\YgoFm.Vision.csproj" />
  </ItemGroup>

</Project>
