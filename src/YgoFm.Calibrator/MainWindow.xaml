<Window x:Class="YgoFm.Calibrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forbidden Memories — Region Cut Tool"
        Height="860" Width="1320" WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Source picking and capture -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Emulator window:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="WindowList" Width="440" DisplayMemberPath="Display" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshWindows" Margin="6,0,12,0" />
                    <Button x:Name="CaptureWindowButton" Content="Capture window" Click="OnCaptureWindow" />
                    <Button x:Name="CaptureScreenButton" Content="Capture screen" Click="OnCaptureScreen" />
                    <TextBlock Text="delay" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox x:Name="DelayList" Width="70" SelectedIndex="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="0 s" Tag="0" />
                        <ComboBoxItem Content="1 s" Tag="1" />
                        <ComboBoxItem Content="3 s" Tag="3" />
                        <ComboBoxItem Content="5 s" Tag="5" />
                    </ComboBox>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Set the emulator to a duel screen with cards in hand before capturing. Use 'Capture screen' with a delay if the emulator runs fullscreen." />
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="No frame captured yet — pick a window and press Capture." />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- The captured frame, with the boxes drawn on top -->
            <ScrollViewer x:Name="Scroller" Background="#2B2B2B"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="Overlay" Background="Transparent" Focusable="True"
                            MouseLeftButtonDown="OnOverlayMouseDown"
                            MouseMove="OnOverlayMouseMove"
                            MouseLeftButtonUp="OnOverlayMouseUp"
                            KeyDown="OnOverlayKeyDown" />
                </Grid>
            </ScrollViewer>

            <!-- Region checklist -->
            <DockPanel Grid.Column="1" Margin="10">

                <TextBlock DockPanel.Dock="Top" Text="Regions to cut" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" x:Name="RegionHint" Style="{StaticResource Hint}"
                           Margin="0,0,0,8" MinHeight="42"
                           Text="Select a region below, then drag a box on the picture." />

                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="ZoomSlider" Width="150" Minimum="0.5" Maximum="6" Value="2"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                ValueChanged="OnZoomChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="ZoomText" Text="2.0x" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <Separator Margin="0,10" />

                    <Button Content="Clear selected region" Click="OnClearRegion" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Save layout" Click="OnSaveLayout" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Load layout" Click="OnLoadLayout" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Export crops to check" Click="OnExportCrops" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="Save full frame as PNG" Click="OnSaveFrame" HorizontalAlignment="Stretch" />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Arrow keys nudge the selected box by one pixel. Hold Shift to resize it. Click the picture first so it has keyboard focus." />
                </StackPanel>

                <ListBox x:Name="RegionListBox" SelectionChanged="OnRegionSelected" Margin="0,0,0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock>
                                    <Run Text="{Binding Marker, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
