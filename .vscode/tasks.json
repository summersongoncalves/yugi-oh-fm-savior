{
  "version": "2.0.0",
  "tasks": [
    {
      // The solution file is YgoFm.slnx, not .sln — .NET 10 emits the newer XML
      // solution format, and "dotnet build YgoFm.sln" fails with MSB1009.
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/YgoFm.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
